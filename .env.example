# Neon — cadena con pooler (la que usa la app en runtime)
DATABASE_URL="postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/caporal?sslmode=verify-full"

# Neon — cadena directa, sin -pooler (la que usan las migraciones)
DIRECT_URL="postgresql://usuario:clave@ep-xxxx.region.aws.neon.tech/caporal?sslmode=verify-full"

# Firma de la sesión. Generar con:  openssl rand -base64 32
SESSION_SECRET="cambiar-esto-por-una-cadena-larga-y-aleatoria"

# Lectura de hojas de conteo con la cámara (console.anthropic.com)
# Sin esta clave la app funciona igual; sólo se apaga el conteo por foto.
ANTHROPIC_API_KEY=""
